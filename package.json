{
  "name": "orazaka-web-admin",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "dev": "next dev --port 3001",
    "build": "next build",
    "start": "next start --port ${PORT:-3001}",
    "lint": "eslint && krizaka-ratchet",
    "validate": "depcruise src --config .dependency-cruiser.cjs && npm run lint && npm test",
    "test": "node --test test/*.test.mts"
  },
  "dependencies": {
    "@krizaka/charts": "^0.1.0",
    "@krizaka/icons": "^0.1.0",
    "@krizaka/intl": "^0.1.0",
    "@krizaka/orazaka-design-system": "*",
    "@krizaka/orazaka-shared": "*",
    "@krizaka/tailwind": "^3.10.0",
    "@krizaka/tokens": "^3.10.0",
    "@krizaka/ui": "^3.10.0",
    "date-fns": "^4.3.0",
    "next": "^16.3.0",
    "next-auth": "^4.24.15",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@krizaka/config": "^0.1.0",
    "@tailwindcss/postcss": "^4",
    "@types/node": "^25",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "dependency-cruiser": "^18.5.0",
    "eslint": "^10",
    "eslint-config-next": "16.4.0",
    "tailwindcss": "^4",
    "typescript": "^6"
  },
  "overrides": {
    "@krizaka/ui": "$@krizaka/ui",
    "@krizaka/tokens": "$@krizaka/tokens",
    "@krizaka/tailwind": "$@krizaka/tailwind"
